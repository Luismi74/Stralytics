# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
# Generated files
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# Environment variables (contains sensitive keys)
.env
.env.local
.env.*.local

# Configuration files
assets/config.jsonns
.flutter-plugins-dependencies

# FVM Version Cache
.fvm/
.fvmrc
.vscode/

# Sensitive configuration files
assets/config.json

# Generated Dart files (build_runner, json_serializable, freezed, etc.)
*.g.dart
*.freezed.dart

# Supabase
supabase/.env
supabase/.env.local
supabase/functions/.env
supabase/config.toml
supabase/.temp